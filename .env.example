# Copiar a .env (raíz para docker compose, o backend/.env para correr la API local)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# EL_NINO | LA_NINA | NEUTRAL — actualizar según el boletín ENSO vigente
TEMPORADA_ENSO=NEUTRAL
# Token para crear instituciones y publicar avisos del Modo Campus (vacío = deshabilitado).
# Generar uno largo y aleatorio, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=
# Modo demo para presentaciones: tormenta | sequia (vacío = pronóstico real)
CLIMA_DEMO=
DATABASE_URL=postgresql+asyncpg://naangareko:naangareko@localhost:5432/naangareko
